# Copy these into your platform's service variables. Never commit real values.

# Required for a stable deployment: a UUID you generate yourself, e.g.
#   cat /proc/sys/kernel/random/uuid   (Linux)
#   uuidgen                            (macOS)
UUID=

# WebSocket path. Pick a random-looking path, e.g. /a1b2c3d4e5f6
WS_PATH=

# PORT is injected automatically by Railway. Set it only for local runs.
# PORT=8080
